# =====================================================================
# Personal Finance Dashboard - Environment Configuration Template
# Copy this file to .env or set environment variables in your OS/IDE.
# Note: Never commit real passwords or production secrets to source control.
# =====================================================================

# Server Port Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/personal_finance_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Spring Active Profiles: 'mysql' for local MySQL, 'default' for embedded H2
SPRING_PROFILES_ACTIVE=mysql

# Application Defaults
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_OPENING_BALANCE=50000.00

